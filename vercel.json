{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "headers":[
    {"source":"/optimized/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/images/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]},
    {"source":"/social-preview.jpg","headers":[{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]}
  ]
}
